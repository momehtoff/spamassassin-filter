# ============================================================================
# БАЗОВЫЕ ПРАВИЛА ДЛЯ ВСЕХ ЛЕГИТИМНЫХ РАССЫЛОК
# ============================================================================

header LIST_UNSUBSCRIBE List-Unsubscribe =~ /\S+/i
score LIST_UNSUBSCRIBE 0

header LIST_PRECEDENCE Precedence =~ /bulk|list|junk/i
score LIST_PRECEDENCE 0

header LIST_ID List-Id =~ /\S+\.\S+/i
score LIST_ID 0

meta LEGITIMATE_MAILING (LIST_UNSUBSCRIBE && LIST_PRECEDENCE && DKIM_VALID)
score LEGITIMATE_MAILING -5.0
describe LEGITIMATE_MAILING Legitimate mailing with proper list headers

# ============================================================================
# ОБЩЕЕ ПРАВИЛО ДЛЯ КРУПНЫХ КОМПАНИЙ (ПО ДОМЕНУ)
# ============================================================================

header TRUSTED_DOMAIN From:addr =~ /@(sender\.ozon\.ru|yandex\.ru|360\.yandex\.ru|emails\.tinkoff\.ru|tbank\.ru|send\.vtb\.ru|vtb\.ru|citilink\.ru|chek\.pofd\.ru|pofd\.ru|saby\.ru|mail-trade\.saby\.ru|acron\.ru|irkutskoil\.ru|bidzaar\.com|astgoz\.ru)$/i
score TRUSTED_DOMAIN 0

meta TRUSTED_DOMAIN_MAIL (TRUSTED_DOMAIN && DKIM_VALID)
score TRUSTED_DOMAIN_MAIL -20.0
describe TRUSTED_DOMAIN_MAIL Email from trusted domain with valid DKIM

