# ============================================================================
# ОБЩЕЕ ПРАВИЛО ДЛЯ ПИСЕМ С КОРРЕКТНЫМИ ЗАГОЛОВКАМИ (FALLBACK)
# ============================================================================

header GENERIC_LIST_ID List-Id =~ /\S+\.\S+/i
header GENERIC_UNSUB List-Unsubscribe =~ /https?:\/\/\S+/i
header GENERIC_PRECEDENCE Precedence =~ /bulk|list|junk/i

meta GENERIC_MAILING_LIST (GENERIC_LIST_ID && GENERIC_UNSUB && GENERIC_PRECEDENCE && DKIM_VALID)
score GENERIC_MAILING_LIST -10.0
describe GENERIC_MAILING_LIST Generic legitimate mailing list with proper headers

# Определяем основные правила для идентификации письма от OFD.RU
header OFDRU_FROM From:addr =~ /ofd\.ru|chek\.pofd\.ru$/i
header OFDRU_DKIM DKIM-Signature =~ /d=ofd\.ru|d=chek\.pofd\.ru/i
header OFDRU_SENDER Sender =~ /noreply@ofd\.ru/i

# Проверяем наличие уникальных маркеров в теле письма
body OFDRU_BODY_1 /ОФД|OFD\.RU|Платформа ОФД/i
body OFDRU_BODY_2 /ofd\.ru/i
body OFDRU_BODY_3 /кассовый чек/i
body OFDRU_BODY_4 /фискальный/i
body OFDRU_BODY_5 /ФН \d+/i
body OFDRU_BODY_6 /ФПД \d+/i
body OFDRU_BODY_7 /QR-код|qrcode/i
body OFDRU_BODY_8 /чек доступен в браузере/i
body OFDRU_BODY_9 /platformaofd\.ru/i
body OFDRU_BODY_10 /спасибо за покупку/i
body OFDRU_BODY_11 /подарок за оплату/i

# Мета-правило: письмо от OFD.RU, если совпадает домен отправителя, DKIM и хотя бы один признак в теле
meta OFDRU_OFFICIAL (OFDRU_FROM && OFDRU_DKIM && (OFDRU_BODY_1 || OFDRU_BODY_2 || OFDRU_BODY_3 || OFDRU_BODY_4 || OFDRU_BODY_5 || OFDRU_BODY_6 || OFDRU_BODY_7 || OFDRU_BODY_8 || OFDRU_BODY_9 || OFDRU_BODY_10 || OFDRU_BODY_11))

# Альтернативное мета-правило для чеков с QR-кодом
body OFDRU_QR /qrcode|QR-код/i
meta OFDRU_QR_CHECK (OFDRU_OFFICIAL && OFDRU_QR)
score OFDRU_QR_CHECK -25.0

# Присваиваем письму очень низкий балл, чтобы оно гарантированно не попало в спам
score OFDRU_OFFICIAL -20.0

# Описываем правила для отчета
describe OFDRU_OFFICIAL Official email from OFD.RU (Platforma OFD) - receipt
describe OFDRU_QR_CHECK Official OFD.RU receipt with QR-code

# Правило для писем с фискальными реквизитами
header OFDRU_FROM_FISCAL From:addr =~ /ofd\.ru|chek\.pofd\.ru$/i
header OFDRU_DKIM_FISCAL DKIM-Signature =~ /d=ofd\.ru|d=chek\.pofd\.ru/i

body OFDRU_FN /ФН \d+/i
body OFDRU_FPD /ФПД \d+/i
body OFDRU_QR /qrcode|QR-код/i
body OFDRU_CHECK /кассовый чек|фискальный/i

meta OFDRU_FISCAL (OFDRU_FROM_FISCAL && OFDRU_DKIM_FISCAL && OFDRU_FN && OFDRU_FPD && OFDRU_QR && OFDRU_CHECK)
score OFDRU_FISCAL -25.0
describe OFDRU_FISCAL Official OFD.RU fiscal receipt with QR-code
